# Africa's Talking - leave AT_API_KEY empty for dry-run (everything is logged, nothing sent)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_VOICE_NUMBER=+234XXXXXXXXXX

# Public URL of this instance (used in voice callback URLs). Optional: derived from the request if empty.
PUBLIC_URL=
USSD_CODE=*384*1234#
ORG_NAME=FieldPass
DEFAULT_LANG=ha

# Protects /dashboard, /simulator and /api with basic auth (any username)
ADMIN_PASSWORD=

# Airtime rewards in NGN (0 disables)
REWARD_STATUS_UPDATE=50
REWARD_BOOKING_COMPLETE=100
REWARD_DAILY_CAP=300
REWARD_MIN_FIELD_AGE_DAYS=0

# Call herders (not just SMS) when a field on their route opens
VOICE_ALERTS=false

# Load a sample season on startup
SEED_DEMO=true

# Optional: override the default Kano wards with your own JSON list
# WARDS=[{"code":"101","name":"Dawanau","lga":"Dawakin Tofa","lat":12.055,"lng":8.43}]
